# ============================================================
# OpenMAIC 环境变量配置
# 使用方法: cp .env.example .env.local 然后填入你的配置
# ============================================================

# ------ LLM API 配置（至少配置一个） ------

# Qwen（通义千问）— 推荐，共用已有的 API Key
# 通过 OpenAI 兼容接口调用 Qwen
OPENAI_API_KEY=sk-your-qwen-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型（使用 Qwen 时配置为 qwen 系列模型）
DEFAULT_MODEL=openai:qwen-plus

# Google Gemini（备选）
# GOOGLE_API_KEY=your-google-api-key

# Anthropic Claude（备选）
# ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI（备选）
# OPENAI_API_KEY=sk-your-openai-key

# ------ TTS 语音合成配置（可选） ------

# MiniMax TTS（推荐，语音质量好）
# TTS_MINIMAX_API_KEY=your-minimax-api-key
# TTS_MINIMAX_GROUP_ID=your-group-id

# ------ 图片生成配置（可选） ------

# MiniMax 图片生成
# IMAGE_MINIMAX_API_KEY=your-minimax-api-key

# ------ PDF 解析增强（可选） ------

# MinerU 服务地址（用于高级 PDF 解析，如表格、公式 OCR）
# PDF_MINERU_BASE_URL=http://localhost:8080
# PDF_MINERU_API_KEY=your-mineru-api-key

# ------ 服务端口（可选） ------

# OpenMAIC 服务端口（默认 3000）
OPENMAIC_PORT=3000
