# ============================================================
# LittleStar 环境变量配置
# 使用方法: cp .env.example .env.local 然后填入你的配置
# ============================================================

# ------ 必填：安全配置 ------

# JWT 密钥（Auth Service 和 PostgREST 共用，必须一致）
# 建议使用 openssl rand -base64 32 生成
JWT_SECRET=your-secure-jwt-secret-change-me

# PostgreSQL 密码
POSTGRES_PASSWORD=your-secure-postgres-password

# ------ 数据库配置（可选，有默认值） ------

POSTGRES_DB=littlestar
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# ------ JWT 配置（可选） ------

# JWT 过期时间（默认 7 天）
JWT_EXPIRES_IN=7d

# ------ 服务端口（可选） ------

# Nginx 网关端口（默认 80）
NGINX_PORT=80

# ------ LLM API 配置（OpenMAIC 使用，至少配置一个） ------

# Qwen（通义千问）— 推荐
OPENAI_API_KEY=sk-your-qwen-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型
DEFAULT_MODEL=openai:qwen-plus

# Google Gemini（备选）
# GOOGLE_API_KEY=your-google-api-key

# Anthropic Claude（备选）
# ANTHROPIC_API_KEY=sk-ant-your-key

# ------ TTS 语音合成配置（可选） ------

# MiniMax TTS
# TTS_MINIMAX_API_KEY=your-minimax-api-key
# TTS_MINIMAX_GROUP_ID=your-group-id

# ------ 图片生成配置（可选） ------

# MiniMax 图片生成
# IMAGE_MINIMAX_API_KEY=your-minimax-api-key
