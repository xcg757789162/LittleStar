# ============================================================
# LittleStar 两容器部署 — 环境变量配置
# 使用方法: cp .env.example .env.local 然后填入你的配置
# ============================================================

# ------ 必填：安全配置 ------

# JWT 密钥（Auth Service 和 PostgREST 共用，必须一致）
# 建议使用 openssl rand -base64 32 生成
JWT_SECRET=your-secure-jwt-secret-change-me

# PostgreSQL 密码
POSTGRES_PASSWORD=your-secure-postgres-password

# ------ 数据库配置（可选，有默认值） ------

POSTGRES_DB=littlestar
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# ------ JWT 配置（可选） ------

# JWT 过期时间（默认 7 天）
JWT_EXPIRES_IN=7d

# ------ 服务端口（可选） ------

# Nginx 网关端口（对外暴露的端口，默认 80）
NGINX_PORT=80

# OpenMAIC 内部端口（容器内部使用，默认 3002）
OPENMAIC_PORT=3002

# ------ OpenMAIC 源码构建配置（可选） ------

# OpenMAIC 源码仓库地址（默认官方仓库）
# OPENMAIC_REPO=https://github.com/THU-MAIC/OpenMAIC.git

# OpenMAIC 分支（默认 main）
# OPENMAIC_BRANCH=main

# ------ LLM API 配置（OpenMAIC 使用，至少配置一个） ------

# Qwen（通义千问）— 推荐
OPENAI_API_KEY=sk-your-qwen-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型
DEFAULT_MODEL=openai:qwen-plus

# ------ TTS 语音合成配置（可选） ------

# MiniMax TTS
TTS_MINIMAX_API_KEY=your-minimax-api-key

# ------ 图片生成配置（可选） ------

# 通义万象图片生成
IMAGE_QWEN_IMAGE_API_KEY=your-qwen-image-api-key
IMAGE_QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
