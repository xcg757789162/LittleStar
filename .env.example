# 通义千问 API 配置
VITE_QWEN_API_KEY=your_qwen_api_key_here
VITE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# CosyVoice TTS 配置
VITE_COSYVOICE_API_KEY=your_cosyvoice_api_key_here
VITE_COSYVOICE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Paraformer STT 配置
VITE_PARAFORMER_API_KEY=your_paraformer_api_key_here
VITE_PARAFORMER_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# OpenMAIC iframe 通信 origin（生产环境必填，开发环境默认 http://localhost:8080）
# 用于 postMessage 安全校验白名单
# VITE_OPENMAIC_ORIGIN=https://your-production-domain.com
