{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist-server",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/server/**/*.ts",
    "src/services/openmaic/pipeline-types.ts",
    "src/services/lesson-planner/lesson-plan-generator.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-server",
    "**/__tests__/**",
    "**/*.test.ts"
  ]
}
